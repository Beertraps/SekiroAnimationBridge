{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sekiro-animation-bridge/motion.schema.json",
  "title": "Motion JSON",
  "description": "One decoded clip and its skeleton in source space. See docs/INTERCHANGE.md.",
  "type": "object",
  "required": ["format", "formatVersion", "clip", "skeletonName", "skeleton", "frameCount", "frameRate", "trackCount",
               "trackBoneIndices", "trackNames", "frames"],
  "properties": {
    "format": {"const": "sekiro-animation-bridge"},
    "formatVersion": {"enum": [1, 2]},
    "clip": {"type": "string", "minLength": 1},
    "skeletonName": {"type": "string"},
    "skeleton": {
      "type": "object",
      "required": ["name", "boneCount", "bones"],
      "properties": {
        "name": {"type": "string"},
        "boneCount": {"type": "integer", "minimum": 1},
        "bones": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bone"}}
      }
    },
    "frameCount": {"type": "integer", "minimum": 1},
    "frameRate": {"type": "number", "exclusiveMinimum": 0},
    "duration": {"type": "number", "minimum": 0},
    "trackCount": {"type": "integer", "minimum": 0},
    "blockCount": {"type": "integer", "minimum": 0},
    "compression": {"type": "string"},
    "trackBoneIndices": {"type": "array", "items": {"type": "integer", "minimum": -1}},
    "trackNames": {"type": "array", "items": {"type": "string"}},
    "rootMotion": {"anyOf": [{"type": "null"}, {"type": "array", "items": {"$ref": "#/$defs/vector4"}}]},
    "rootUp": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/vector4"}]},
    "rootForward": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/vector4"}]},
    "frames": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"$ref": "#/$defs/transform"}}},
    "game": {"type": "string"},
    "archive": {"type": "string"},
    "member": {"type": "string"},
    "sourceHavok": {"type": "object"},
    "source": {
      "type": "object",
      "required": ["engine"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "game": {"type": "string"},
        "container": {"type": "string"},
        "version": {"type": ["integer", "string"]},
        "archive": {"type": "string"},
        "member": {"type": "string"},
        "index": {"type": "integer", "minimum": 0}
      }
    },
    "basis": {"$ref": "#/$defs/basis"},
    "unitScale": {"type": "number", "exclusiveMinimum": 0}
  },
  "if": {"properties": {"formatVersion": {"const": 2}}},
  "then": {"required": ["source", "basis", "unitScale"]},
  "$defs": {
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "vector4": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "basis": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/vector3"}},
    "transform": {
      "type": "object",
      "required": ["translation", "rotation", "scale"],
      "properties": {
        "translation": {"$ref": "#/$defs/vector3"},
        "rotation": {"$ref": "#/$defs/vector4"},
        "scale": {"$ref": "#/$defs/vector3"}
      }
    },
    "bone": {
      "type": "object",
      "required": ["index", "name", "parent", "translation", "rotation", "scale"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "minLength": 1},
        "parent": {"type": "integer", "minimum": -1},
        "translation": {"$ref": "#/$defs/vector3"},
        "rotation": {"$ref": "#/$defs/vector4"},
        "scale": {"$ref": "#/$defs/vector3"}
      }
    }
  }
}
