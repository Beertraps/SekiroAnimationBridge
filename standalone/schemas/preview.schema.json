{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sekiro-animation-bridge/preview.schema.json",
  "title": "Preview JSON",
  "description": "Joint positions for the UI's skeleton preview. See docs/INTERCHANGE.md.",
  "type": "object",
  "required": ["clip", "skeleton", "frameCount", "frameRate", "frameStep", "bones", "parents", "positions"],
  "properties": {
    "clip": {"type": "string"},
    "skeleton": {"type": "string"},
    "frameCount": {"type": "integer", "minimum": 1},
    "frameRate": {"type": "number", "exclusiveMinimum": 0},
    "duration": {"type": "number", "minimum": 0},
    "frameStep": {"type": "integer", "minimum": 1},
    "bones": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "parents": {"type": "array", "items": {"type": "integer", "minimum": -1}},
    "tracks": {"type": "integer", "minimum": 0},
    "positions": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
    "detached": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "root": {"anyOf": [{"type": "null"}, {"type": "array", "items": {"$ref": "motion.schema.json#/$defs/vector4"}}]},
    "basis": {"$ref": "motion.schema.json#/$defs/basis"},
    "unitScale": {"type": "number", "exclusiveMinimum": 0}
  }
}
