{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sekiro-animation-bridge/package.schema.json",
  "title": "Game package",
  "description": "package.json of a game package: its identity, games, source options, tools and bone names. See docs/PACKAGES.md.",
  "type": "object",
  "required": ["id", "name", "version", "apiVersion", "games"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "apiVersion": {"type": "integer", "minimum": 1},
    "description": {"type": "string"},
    "authors": {"type": "array", "items": {"type": "string"}},
    "license": {"type": "string"},
    "homepage": {"type": "string"},
    "games": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/game"}},
    "sourceOptions": {"type": "array", "items": {"anyOf": [{"enum": ["fileList"]}, {"$ref": "#/$defs/sourceOption"}]}},
    "tools": {"type": "array", "items": {"$ref": "#/$defs/tool"}},
    "bones": {"$ref": "#/$defs/bones"}
  },
  "$defs": {
    "game": {
      "type": "object",
      "required": ["id", "name", "short"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "short": {"type": "string", "minLength": 1},
        "executables": {"type": "array", "items": {"type": "string"}},
        "capabilities": {
          "type": "object",
          "properties": {
            "import_animation": {"type": "boolean"},
            "import_character": {"type": "boolean"},
            "textures": {"type": "boolean"},
            "export": {"const": false},
            "add_to_binder": {"const": false},
            "root_motion": {"type": "boolean"},
            "weapons": {"const": false},
            "part_animations": {"const": false},
            "packed_archives": {"type": "boolean"}
          }
        },
        "basis": {"$ref": "motion.schema.json#/$defs/basis"},
        "unitScale": {"type": "number", "exclusiveMinimum": 0},
        "formats": {"type": "object"},
        "hint": {"type": "string"},
        "verified": {"type": "boolean"},
        "documentation": {"type": "string"}
      }
    },
    "sourceOption": {
      "type": "object",
      "required": ["id", "name", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["text", "secret", "file", "choice"]},
        "help": {"type": "string"},
        "placeholder": {"type": "string"},
        "filter": {"type": "string"},
        "default": {"type": "string"},
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": {"value": {"type": "string"}, "label": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "tool": {
      "type": "object",
      "required": ["id", "name", "path"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "version": {"type": "array", "items": {"type": "string"}},
        "expect": {"type": "string"},
        "runtime": {"enum": ["", "dotnet-9"]},
        "build": {"type": "string"},
        "help": {"type": "string"}
      }
    },
    "bones": {
      "type": "object",
      "properties": {
        "names": {"type": "object"},
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["match", "as"],
            "properties": {"match": {"type": "string", "minLength": 1}, "as": {"type": "string"}}
          }
        }
      }
    }
  }
}
