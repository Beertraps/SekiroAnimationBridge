{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sekiro-animation-bridge/character.schema.json",
  "title": "Character manifest",
  "description": "The models of a character with their materials, arrays and textures. See docs/INTERCHANGE.md.",
  "type": "object",
  "required": ["version", "game", "models", "warnings", "texture_count"],
  "properties": {
    "version": {"enum": [4, 5]},
    "game": {"type": "string"},
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "material_library": {"type": "string"},
    "attachment_reference": {"type": "string"},
    "texture_count": {"type": "integer", "minimum": 0},
    "basis": {"$ref": "motion.schema.json#/$defs/basis"},
    "unitScale": {"type": "number", "exclusiveMinimum": 0},
    "boneRotation": {"enum": ["euler_xzy", "quaternion"]}
  },
  "$defs": {
    "image": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "linear": {"type": "boolean"},
            "uv": {"type": "integer", "minimum": 0},
            "scale": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
            "stem": {"type": "string"},
            "convention": {"enum": ["directx", "opengl"]},
            "channels": {"enum": ["xy", "xyz"]}
          }
        }
      ]
    },
    "material": {
      "type": "object",
      "required": ["name", "albedo", "normal", "emissive", "samplers"],
      "properties": {
        "name": {"type": "string"},
        "mtd": {"type": "string"},
        "albedo": {"$ref": "#/$defs/image"},
        "normal": {"$ref": "#/$defs/image"},
        "emissive": {"$ref": "#/$defs/image"},
        "tint": {"$ref": "#/$defs/image"},
        "samplers": {"type": "array", "items": {"type": "object"}},
        "alpha": {"type": "boolean"},
        "color": {"type": "array", "items": {"type": "number"}}
      }
    },
    "model": {
      "type": "object",
      "required": ["name", "source", "data", "materials", "stats"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source": {"type": "string"},
        "data": {"type": "string", "minLength": 1},
        "materials": {"type": "array", "items": {"$ref": "#/$defs/material"}},
        "stats": {
          "type": "object",
          "required": ["vertices", "triangles"],
          "properties": {
            "vertices": {"type": "integer", "minimum": 0},
            "triangles": {"type": "integer", "minimum": 0}
          }
        },
        "attachment": {"anyOf": [{"type": "null"}, {"type": "object"}]}
      }
    }
  }
}
